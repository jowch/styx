# Dev overrides for plugin MCP launcher (copy to .env.dev).
# Loaded by scripts/pluto-mcp-launcher.sh and scripts/ensure-julia-env.sh.

# Local PlutoMCP.jl fork (required for require_secret_for_access and Phase 1 tools)
PLUTOMCP_SOURCE=/path/to/PlutoMCP.jl

# Set to 1 to re-run Pkg.develop/instantiate on next MCP connect
# PLUTOMCP_ENV_FORCE=1

# Optional port overrides
# PLUTOMCP_MCP_PORT=2346
# PLUTOMCP_PLUTO_PORT=1234

# Optional Julia binary
# JULIA=julia
